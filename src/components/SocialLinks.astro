---
import type { SocialLinks } from '~/types'
interface Props {
  socialLinks: SocialLinks
}
const { socialLinks } = Astro.props
const labels = {
  github: 'GitHub',
  mastodon: 'Mastodon',
  twitter: 'Twitter',
  linkedin: 'LinkedIn',
  bluesky: 'Bluesky',
  email: 'Email',
  rss: 'RSS',
}
---

<nav class="inline-links" aria-label="Social links">
  {
    Object.entries(socialLinks)
      .filter(([, value]) => value)
      .map(([key, value]) => (
        <a
          href={
            key === 'rss' ? '/feed' : key === 'email' ? `mailto:${value}` : String(value)
          }
        >
          {labels[key as keyof typeof labels]}
        </a>
      ))
  }
</nav>
