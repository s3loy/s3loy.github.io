---
import siteConfig from '~/site.config'
import Search from './Search.astro'
import SelectTheme from './SelectTheme.astro'
import ArticleLanguages from './ArticleLanguages.astro'
import type { CollectionEntry } from 'astro:content'
interface Props {
  articleVersions?: CollectionEntry<'posts'>[]
}
const { articleVersions = [] } = Astro.props
const path = Astro.url.pathname.replace(/\/$/, '') || '/'
---

<header class="site-header">
  <a class="site-title" href="/">{siteConfig.title}</a>
  <nav aria-label="Main navigation">
    {
      siteConfig.navLinks.map((link) => (
        <a href={link.url} aria-current={path === link.url ? 'page' : undefined}>
          {link.name}
        </a>
      ))
    }
  </nav>
  <div class="site-tools">
    <Search trailingSlashes={siteConfig.trailingSlashes} />
    {articleVersions.length > 0 && <ArticleLanguages versions={articleVersions} />}
    <SelectTheme />
  </div>
</header>
