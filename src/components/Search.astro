---
const { trailingSlashes = false } = Astro.props
---

<div id="search" data-trailing-slashes={trailingSlashes}>
  <button
    id="open-search"
    aria-controls="search-dialog"
    aria-keyshortcuts="Control+K Meta+K"
    disabled>Search</button
  >
  <dialog id="search-dialog" aria-label="Search">
    <div class="search-heading">
      <h2>Search</h2>
      <button id="close-search" aria-label="Close search">Close</button>
    </div>
    {
      import.meta.env.DEV ? (
        <p>Search is available in the production preview.</p>
      ) : (
        <div id="pagefind-search" />
      )
    }
    <p id="search-status" role="status"></p>
  </dialog>
</div>
<script>
  const dialog = document.querySelector<HTMLDialogElement>('#search-dialog')!
  const trigger = document.querySelector<HTMLButtonElement>('#open-search')!
  let ready: Promise<void> | undefined
  async function loadSearch() {
    if (import.meta.env.DEV) return
    const { PagefindUI } = await import('@pagefind/default-ui')
    const trailing =
      document.querySelector<HTMLElement>('#search')?.dataset.trailingSlashes === 'true'
    const format = (url: string) => (trailing ? url : url.replace(/(.)\/(#.*)?$/, '$1$2'))
    new PagefindUI({
      element: '#pagefind-search',
      baseUrl: import.meta.env.BASE_URL,
      bundlePath: import.meta.env.BASE_URL.replace(/\/$/, '') + '/pagefind/',
      showImages: false,
      showSubResults: true,
      processResult: (result: { url: string; sub_results: { url: string }[] }) => ({
        ...result,
        url: format(result.url),
        sub_results: result.sub_results.map((item) => ({
          ...item,
          url: format(item.url),
        })),
      }),
    })
  }
  async function open() {
    document
      .querySelectorAll<HTMLDialogElement>('dialog[open]')
      .forEach((item) => item.close())
    dialog.showModal()
    document.querySelector('#search-status')!.textContent = ''
    try {
      await (ready ||= loadSearch())
      if (dialog.open) dialog.querySelector('input')?.focus()
    } catch {
      ready = undefined
      document.querySelector('#search-status')!.textContent =
        'Search failed to load. Close and try again.'
    }
  }
  trigger.disabled = false
  trigger.addEventListener('click', open)
  document.querySelector('#close-search')!.addEventListener('click', () => dialog.close())
  dialog.addEventListener('click', (event) => {
    if (event.target === dialog) {
      const rect = dialog.getBoundingClientRect()
      if (
        event.clientX < rect.left ||
        event.clientX > rect.right ||
        event.clientY < rect.top ||
        event.clientY > rect.bottom
      )
        dialog.close()
    }
  })
  dialog.addEventListener('close', () => trigger.focus())
  document.addEventListener('keydown', (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault()
      dialog.open ? dialog.close() : open()
    }
  })
</script>
