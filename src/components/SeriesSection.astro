---
import type { CollectionEntry } from 'astro:content'
import { SeriesGroup } from '~/utils'
interface Props {
  posts: CollectionEntry<'posts'>[]
}
const group = await SeriesGroup.build(Astro.props.posts)
---

<ul class="link-list">
  {
    group.sortCollationsMostRecent().map((series) => (
      <li>
        <a href={series.url}>
          {series.title}
          <span>{series.entries.length}</span>
        </a>
      </li>
    ))
  }
</ul>
