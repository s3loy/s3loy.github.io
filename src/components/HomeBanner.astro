---
import { Image } from 'astro:assets'
import type { FrontmatterImage } from '~/types'
interface Props {
  avatarImage?: FrontmatterImage
}
const { avatarImage } = Astro.props
---

<div class="home-profile">
  {
    avatarImage && (
      <Image
        priority
        src={avatarImage.src}
        alt={avatarImage.alt}
        class="home-avatar"
        widths={[80]}
        height={40}
        width={40}
      />
    )
  }
  <div class="home-intro prose"><slot /></div>
</div>
