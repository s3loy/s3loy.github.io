<button id="theme-toggle" type="button" aria-label="Switch color theme" disabled
  >Theme</button
>
<script>
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle')!
  const root = document.documentElement
  let timer: ReturnType<typeof setTimeout>
  const update = () => {
    const next = root.dataset.theme === 'github-dark' ? 'light' : 'dark'
    button.textContent = next === 'light' ? 'Light' : 'Dark'
    button.setAttribute('aria-label', `Switch to ${next} theme`)
  }
  update()
  button.disabled = false
  button.addEventListener('click', () => {
    clearTimeout(timer)
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      root.classList.add('theme-transition')
      timer = setTimeout(() => root.classList.remove('theme-transition'), 300)
    } else root.classList.remove('theme-transition')
    const dark = root.dataset.theme !== 'github-dark'
    root.dataset.theme = dark ? 'github-dark' : 'github-light'
    root.style.colorScheme = dark ? 'dark' : 'light'
    try {
      localStorage.setItem('data-theme', root.dataset.theme)
    } catch {}
    update()
  })
</script>
