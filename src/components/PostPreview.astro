---
import type { CollectionEntry } from 'astro:content'
import { dateString } from '~/utils'
interface Props {
  post: CollectionEntry<'posts'>
}
const { post } = Astro.props
const modified = post.data.modified ?? post.data.published
const articleLink =
  Astro.url.pathname.replace(/\/$/, '') === `/posts/${post.id}`
    ? `#${post.id}`
    : `/posts/${post.id}`
---

<article class="post-preview">
  <div class="post-preview-row">
    <h2 class="post-preview-title"><a href={articleLink}>{post.data.title}</a></h2>
    <div class="post-preview-dates">
      <time datetime={post.data.published.toISOString()}
        >published {dateString(post.data.published)}</time
      >
      <time datetime={modified.toISOString()}>updated {dateString(modified)}</time>
    </div>
  </div>
</article>
