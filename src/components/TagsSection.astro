---
import type { CollectionEntry } from 'astro:content'
import { TagsGroup } from '~/utils'
interface Props {
  posts: CollectionEntry<'posts'>[]
}
const group = await TagsGroup.build(Astro.props.posts)
---

<ul class="link-list">
  {
    group.sortCollationsLargest().map((tag) => (
      <li>
        <a href={`/archives?tag=${encodeURIComponent(tag.titleSlug)}`}>
          {tag.title}
          <span>{tag.entries.length}</span>
        </a>
      </li>
    ))
  }
</ul>
