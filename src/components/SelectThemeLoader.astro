<script is:inline>
  ;(() => {
    const root = document.documentElement
    try {
      const saved = localStorage.getItem('data-theme')
      if (saved?.startsWith('github-light')) root.dataset.theme = 'github-light'
      else if (saved?.startsWith('github-dark')) root.dataset.theme = 'github-dark'
    } catch {}
    root.style.colorScheme = root.dataset.theme === 'github-light' ? 'light' : 'dark'
  })()
</script>
