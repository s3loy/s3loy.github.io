---
import type { FriendLink } from '~/types'
interface Props {
  friend: FriendLink
}
const { friend } = Astro.props
---

<a class="friend" href={friend.url} target="_blank" rel="noopener noreferrer">
  <span class="friend-picture" aria-hidden="true">
    <span class="friend-avatar-fallback">{Array.from(friend.name)[0] || '?'}</span>
    <img
      class="friend-avatar"
      src={friend.avatar}
      alt=""
      width="40"
      height="40"
      loading="lazy"
      decoding="async"
    />
  </span>
  <span class="friend-text"
    ><span class="friend-name">{friend.name}</span><span class="friend-description"
      >{friend.description}</span
    ></span
  >
</a>
<script>
  document.querySelectorAll<HTMLImageElement>('.friend-avatar').forEach((image) => {
    const fallback = () => {
      image.hidden = true
    }
    image.addEventListener('error', fallback, { once: true })
    if (image.complete && !image.naturalWidth) fallback()
  })
</script>
