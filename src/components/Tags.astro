---
import type { Collation } from '~/types'
interface Props {
  tags: Collation<'posts'>[]
}
const { tags } = Astro.props
---

<ul class="link-list" aria-label="Tags">
  {
    tags.map((tag) => (
      <li>
        <a href={`/archives?tag=${encodeURIComponent(tag.titleSlug)}`}>{tag.title}</a>
      </li>
    ))
  }
</ul>
