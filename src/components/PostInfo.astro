---
import { dateString } from '~/utils'
import type { Collation } from '~/types'
import type { CollectionEntry } from 'astro:content'
interface Props {
  post: CollectionEntry<'posts'>
  minutesRead?: string
  series?: Collation<'posts'>
}
const { post, minutesRead, series } = Astro.props
const modified = post.data.modified ?? post.data.published
const position = series ? series.entries.findIndex((p) => p.id === post.id) + 1 : 0
---

<div class="post-meta">
  <div class="post-preview-dates">
    <time datetime={post.data.published.toISOString()}
      >published {dateString(post.data.published)}</time
    >
    <time datetime={modified.toISOString()}>updated {dateString(modified)}</time>
  </div>
  <div class="inline-links">
    {post.data.author && <span>{post.data.author}</span>}
    {minutesRead && <span>{minutesRead}</span>}
    {
      series && (
        <a href={series.url}>
          {series.title} {position} / {series.entries.length}
        </a>
      )
    }
  </div>
</div>
