---
interface Props {
  prevLink?: string
  prevText?: string
  nextLink?: string
  nextText?: string
}
const { prevLink, prevText = 'Previous', nextLink, nextText = 'Next' } = Astro.props
---

{
  (prevLink || nextLink) && (
    <nav class="pagination" aria-label="Pagination">
      {prevLink && (
        <a href={prevLink} rel="prev">
          ← {prevText}
        </a>
      )}
      {nextLink && (
        <a href={nextLink} rel="next">
          {nextText} →
        </a>
      )}
    </nav>
  )
}
