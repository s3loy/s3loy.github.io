---
import siteConfig from '~/site.config'
import Layout from '~/layouts/Layout.astro'
import FriendCard from '~/components/FriendCard.astro'
import friends from '~/data/links.json'
---

<Layout title="Friends" description={siteConfig.description}>
  <section class="friends" aria-label="Friends">
    {friends.map((friend) => <FriendCard friend={friend} />)}
  </section>
</Layout>
