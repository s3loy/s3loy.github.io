---
import type { GetStaticPaths } from 'astro'
import Layout from '~/layouts/Layout.astro'
import { SeriesGroup, TagsGroup, getSortedPosts } from '~/utils'
import PostPreview from '~/components/PostPreview.astro'
import BlockHeader from '~/components/BlockHeader.astro'
import { render, type CollectionEntry } from 'astro:content'
import TableOfContents from '~/components/TableOfContents.astro'
import { Image } from 'astro:assets'
import GiscusLoader from '~/components/GiscusLoader.astro'
import siteConfig from '~/site.config'
import Tags from '~/components/Tags.astro'
import PostInfo from '~/components/PostInfo.astro'
import type { Collation } from '~/types'
import { getPostSequenceContext } from '~/utils'
import { getArticleVersions } from '~/article-languages'

export const getStaticPaths = (async () => {
  const posts = await getSortedPosts('all')
  return posts.map((post) => {
    const { prev, next } = getPostSequenceContext(
      post,
      posts.filter((entry) => entry.data.lang === post.data.lang),
    )
    return {
      params: { slug: post.id },
      props: { post, prev, next, versions: getArticleVersions(post, posts) },
    }
  })
}) satisfies GetStaticPaths

const { post, prev, next, versions } = Astro.props
const alternates =
  versions.length > 1
    ? versions.map((version) => ({
        lang: version.data.lang,
        url: `/posts/${version.id}`,
      }))
    : []
const postData = post.data
const { headings, Content: PostContent, remarkPluginFrontmatter } = await render(post)
const description = postData.description ?? remarkPluginFrontmatter.description

const sortedPosts = (await getSortedPosts(postData.lang)).filter(
  (entry) => entry.data.lang === postData.lang,
)

let series: Collation<'posts'> | undefined
let nextPostInSeries: CollectionEntry<'posts'> | undefined
if (postData.series) {
  const seriesGroup = await SeriesGroup.build(sortedPosts)
  series = seriesGroup.match(postData.series)
  if (!series) {
    throw new Error(`Series "${postData.series}" not found`)
  }
  const sequenceContext = getPostSequenceContext(post, series.entries)
  nextPostInSeries = sequenceContext.next
}
const showSeries = series && series.entries.length > 1

let tags: Collation<'posts'>[] | undefined
if (postData.tags && postData.tags.length > 0) {
  const tagsGroup = await TagsGroup.build(sortedPosts)
  tags = tagsGroup.matchMany(postData.tags)
}
---

<Layout
  article
  title={postData.title}
  description={description}
  author={postData.author}
  tags={postData.tags}
  alternates={alternates}
  articleVersions={versions}
>
  <article data-pagefind-body>
    {
      postData.coverImage && (
        <Image
          priority
          layout="constrained"
          src={postData.coverImage.src}
          alt={postData.coverImage.alt}
          class="post-cover"
        />
      )
    }
    <header class="post-header">
      <h1 id={post.id} lang={postData.lang}>{postData.title}</h1>
      <PostInfo
        post={post}
        minutesRead={remarkPluginFrontmatter.minutesRead}
        series={series}
      />
      {tags && <Tags tags={tags} />}
    </header>
    {postData.toc && <TableOfContents headings={headings} lang={postData.lang} />}
    <div class="article-content prose" lang={postData.lang}><PostContent /></div>
  </article>
  {
    nextPostInSeries && (
      <p>
        <a href={`/posts/${nextPostInSeries.id}`}>
          Next: {nextPostInSeries.data.title} →
        </a>
      </p>
    )
  }
  {
    showSeries && series ? (
      <section>
        <BlockHeader>{series.title} Series</BlockHeader>
        {series.entries.map((seriesPost) => (
          <PostPreview post={seriesPost} />
        ))}
      </section>
    ) : (
      (prev || next) && (
        <section>
          <BlockHeader>More Posts</BlockHeader>
          {prev && <PostPreview post={prev} />}
          {next && <PostPreview post={next} />}
        </section>
      )
    )
  }
  {
    siteConfig.giscus && (
      <section>
        <>
          <BlockHeader>Comments</BlockHeader>
          <GiscusLoader />
        </>
      </section>
    )
  }
  <a class="back-to-top" href="#top" aria-label="Back to top">Back to top ↑</a>
</Layout>
