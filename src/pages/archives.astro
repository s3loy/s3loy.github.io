---
import Layout from '~/layouts/Layout.astro'
import PageHeader from '~/components/PageHeader.astro'
import { getSortedPosts, TagsGroup, dateString } from '~/utils'
import { slug } from 'github-slugger'
const posts = (await getSortedPosts()).sort(
  (a, b) => b.data.published.getTime() - a.data.published.getTime(),
)
const tags = (await TagsGroup.build(posts)).sortCollationsLargest()
const years = [...new Set(posts.map((post) => post.data.published.getFullYear()))]
---

<Layout title="Archives" description="Compact timeline of all posts">
  <PageHeader title="Archives" />
  <nav class="archive-filters" aria-label="Filter by tag">
    <a class="filter-chip" data-value="all" href="/archives">All</a>
    {
      tags.map((tag) => (
        <a
          class="filter-chip"
          data-value={tag.titleSlug}
          href={`/archives?tag=${encodeURIComponent(tag.titleSlug)}`}
        >
          {tag.title}
          <span class="chip-count">{tag.entries.length}</span>
        </a>
      ))
    }
  </nav>
  <p class="archive-total" role="status">
    <span id="archives-total-count">{posts.length}</span> posts
  </p>
  {
    years.map((year) => (
      <section data-year>
        <h2 class="archive-year-title">{year}</h2>
        <ul class="archive-list">
          {posts
            .filter((post) => post.data.published.getFullYear() === year)
            .map((post) => (
              <li
                class="archive-item"
                data-post
                data-tags={post.data.tags.map((tag) => slug(tag.trim())).join(',')}
              >
                <time class="archive-date" datetime={post.data.published.toISOString()}>
                  {dateString(post.data.published).slice(5)}
                </time>
                <a class="archive-link" href={`/posts/${post.id}`}>
                  {post.data.title}
                </a>
              </li>
            ))}
        </ul>
      </section>
    ))
  }
</Layout>
<script>
  const chips = [...document.querySelectorAll<HTMLAnchorElement>('.filter-chip')]
  const posts = [...document.querySelectorAll<HTMLElement>('[data-post]')]
  function filter() {
    const requested = new URLSearchParams(location.search).get('tag') || 'all'
    const active = chips.some((chip) => chip.dataset.value === requested)
      ? requested
      : 'all'
    let count = 0
    posts.forEach((post) => {
      const visible =
        active === 'all' || post.dataset.tags?.split(',').includes(active) === true
      post.hidden = !visible
      post.toggleAttribute('inert', !visible)
      if (visible) count++
    })
    document.querySelectorAll<HTMLElement>('[data-year]').forEach((year) => {
      year.hidden = !year.querySelector('[data-post]:not([hidden])')
    })
    chips.forEach((chip) => {
      if (chip.dataset.value === active) chip.setAttribute('aria-current', 'true')
      else chip.removeAttribute('aria-current')
    })
    document.querySelector('#archives-total-count')!.textContent = String(count)
  }
  chips.forEach((chip) =>
    chip.addEventListener('click', (event) => {
      if (
        event.button ||
        event.metaKey ||
        event.ctrlKey ||
        event.shiftKey ||
        event.altKey
      )
        return
      event.preventDefault()
      if (chip.href !== location.href) history.pushState(null, '', chip.href)
      filter()
    }),
  )
  window.addEventListener('popstate', filter)
  filter()
</script>
