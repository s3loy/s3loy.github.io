---
import Layout from '~/layouts/Layout.astro'
import { getSortedPosts } from '~/utils'
import { getCollection, render } from 'astro:content'
import PostPreview from '~/components/PostPreview.astro'
import BlockHeader from '~/components/BlockHeader.astro'
import HomeBanner from '~/components/HomeBanner.astro'
import TagsSection from '~/components/TagsSection.astro'
import SeriesSection from '~/components/SeriesSection.astro'
const [home] = await getCollection('home')
const HomeContent = home ? (await render(home)).Content : undefined
const posts = await getSortedPosts()
---

<Layout>
  {
    HomeContent && (
      <HomeBanner avatarImage={home.data.avatarImage}>
        <HomeContent />
      </HomeBanner>
    )
  }
  {
    posts.length > 0 && (
      <section>
        <BlockHeader>Posts</BlockHeader>
        {posts.map((post) => (
          <PostPreview post={post} />
        ))}
      </section>
    )
  }
  {
    posts.some((post) => post.data.series) && (
      <section>
        <>
          <BlockHeader>Series</BlockHeader>
          <SeriesSection posts={posts} />
        </>
      </section>
    )
  }
  {
    posts.some((post) => post.data.tags.length) && (
      <section>
        <>
          <BlockHeader>Tags</BlockHeader>
          <TagsSection posts={posts} />
        </>
      </section>
    )
  }
</Layout>
