{
  "name": "s3loy-blog",
  "description": "A minimal, content-first Astro blog.",
  "type": "module",
  "version": "1.0.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "postbuild": "pagefind --site dist",
    "preview": "astro preview",
    "astro": "astro",
    "format": "prettier --write \"src/**/*.{astro,ts,css}\" \"tests/**/*.mjs\" astro.config.mjs prettier.config.js package.json tsconfig.json giscus.json .github/workflows/astro.yml",
    "test": "node --test tests/*.test.mjs",
    "check": "astro check",
    "format:check": "prettier --check \"src/**/*.{astro,ts,css}\" \"tests/**/*.mjs\" astro.config.mjs prettier.config.js package.json tsconfig.json giscus.json .github/workflows/astro.yml"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@astrojs/ts-plugin": "^1.10.10",
    "@expo-google-fonts/jetbrains-mono": "^0.4.0",
    "@expressive-code/plugin-line-numbers": "^0.44.1",
    "@pagefind/default-ui": "^1.4.0",
    "@resvg/resvg-js": "^2.6.2",
    "@types/hast": "^3.0.4",
    "@types/react": "^19.1.12",
    "astro": "^7.2.0",
    "astro-expressive-code": "^0.44.1",
    "color": "^5.0.0",
    "emoji-regex": "^10.5.0",
    "gemoji": "^8.1.0",
    "github-slugger": "^2.0.0",
    "hastscript": "^9.0.1",
    "katex": "^0.16.22",
    "markdown-it": "^14.1.0",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-find-and-replace": "^3.0.2",
    "mdast-util-to-markdown": "^2.1.2",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.13.0",
    "playwright": "^1.58.2",
    "reading-time": "^1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-external-links": "^3.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-mermaid": "^3.0.0",
    "rehype-unwrap-images": "^1.0.0",
    "remark-directive": "^4.0.0",
    "remark-math": "^6.0.0",
    "sanitize-html": "^2.17.0",
    "satori": "^0.18.2",
    "satori-html": "^0.3.2",
    "typescript": "^5.9.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/markdown-it": "^14.1.2",
    "@types/sanitize-html": "^2.16.0",
    "pagefind": "^1.4.0",
    "parse5": "^8.0.1",
    "prettier": "3.6.2",
    "prettier-plugin-astro": "0.14.1"
  }
}
